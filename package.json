{
  "name": "application-tracker",
  "private": true,
  "type": "module",
  "version": "0.1.1",
  "description": "Cross-browser application tracking assistant extension.",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm --filter @application-tracker/extension dev",
    "dev:edge": "corepack pnpm --filter @application-tracker/extension dev:edge",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
